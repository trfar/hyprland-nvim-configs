# NOTHING loads this file automatically. Copy the block for YOUR
# shell into that shell's config file, fill in the values, then
# restart your shell (Open a new Terminal Window).
#
#   bash  -> ~/.bashrc
#   zsh   -> ~/.zshrc
#   fish  -> ~/.config/fish/config.fish
#
# Variables used by the Neovim AI section (CodeCompanion):
#
#   NVIM_AI_URL         Base URL of your OpenAI-compatible server.
#                       Default: http://localhost:8080 (llama.cpp)
#   NVIM_AI_API_KEY     API Key the server expects.
#                       Default: none
#   NVIM_AI_MODEL_NAME  Model name the server reports. Required.
#   NVIM_AI_CHAT_URL    Chat path appended to NVIM_AI_URL.
#                       Default: /v1/chat/completions 



# bash / zsh   (~/.bashrc or ~/.zshrc)
export NVIM_AI_URL="http(s)://IP-or-localhost::PORT"
export NVIM_AI_API_KEY="your-key-here"
export NVIM_AI_MODEL_NAME="your-model-name"
export NVIM_AI_CHAT_URL="/v1/chat/completions"



# fish   (~/.config/fish/config.fish)
set -gx NVIM_AI_URL http://localhost:1024
set -gx NVIM_AI_API_KEY your-key-here
set -gx NVIM_AI_MODEL_NAME your-model-name
set -gx NVIM_AI_CHAT_URL /v1/chat/completions
