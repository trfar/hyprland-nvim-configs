# Hyprland machine config.
#
# Copy this file to hypr/.env and edit it (scripts/arch.sh does the copy for you).
# hyprland.lua loads it on startup; it lives next to hyprland.lua in the repo and
# gets symlinked into ~/.config/hypr like the other config files.
#
# Syntax: KEY=VALUE, one per line. # starts a comment. No quotes, no spaces around =.
# A missing key falls back to the built-in default in hyprland.lua (which matches
# the values below). For SECONDARY_MONITOR and the wallpaper keys an explicit
# empty value means "none / skip" (see below).
#
# Find your monitor names with: hyprctl monitors   (run after logging into Hyprland)

# --- MONITORS -------------------------------------------------------------
# PRIMARY_MONITOR   main monitor (workspaces 1-5 in dual setup, wallpaper, lock bg)
# SECONDARY_MONITOR second monitor (workspaces 6-10, master layout)
#
# SINGLE-MONITOR SETUP (e.g. a ThinkPad): set SECONDARY_MONITOR to nothing.
# All workspaces 1-10 then live on the one monitor with the scrolling layout.
#   SECONDARY_MONITOR=
PRIMARY_MONITOR=DP-1
SECONDARY_MONITOR=DP-2

# Wallpaper per monitor (set by swaybg at startup). Copy your wallpapers to
# these paths or point these at existing files; set a key to nothing to skip
# that monitor's wallpaper.
WALLPAPER_PRIMARY=/home/trfar/Pictures/Wallpapers/Active.png
WALLPAPER_SECONDARY=/home/trfar/Pictures/Wallpapers/Active-Cropped.png

# --- APPS (command run by the keybind; flags allowed) ---------------------
TERMINAL=alacritty
# strata is a custom binary, not a pacman package — copy it from your old
# machine to ~/.local/bin/strata, or point this at any file manager (e.g. thunar).
FILEMANAGER=/home/trfar/.local/bin/strata
MENU=fuzzel
BROWSER=zen-browser
# obsidian is AUR-only (obsidian-bin); install it with your AUR helper or
# point this at another note app.
OBSIDIAN=obsidian --disable-gpu
